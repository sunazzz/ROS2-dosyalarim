</joint>

<joint name="Revolute 5" type="continuous">
  <origin xyz="-0.025 0.0 0.1985" rpy="0 0 0"/>
  <parent link="link_4_1"/>
  <child link="link_5_1"/>
  <axis xyz="0.0 0.0 -1.0"/>
</joint>

<joint name="Revolute 6" type="continuous">
  <origin xyz="0.1285 0.0 -0.016" rpy="0 0 0"/>
  <parent link="link_5_1"/>
  <child link="link_6_1"/>
  <axis xyz="1.0 0.0 0.0"/>
</joint>

</robot>
